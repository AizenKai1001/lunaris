  "systems": [
    {
      "name": "fp_axes",
      "doc": "Which way is ahead and to the right on the ground, from the look.",
      "each": [
        "MouseLook"
      ],
      "order": 9,
      "do": [
        {
          "res_set": "look.fx",
          "to": {
            "get": "MouseLook.forward[0]"
          }
        },
        {
          "res_set": "look.fz",
          "to": {
            "get": "MouseLook.forward[2]"
          }
        },
        {
          "res_set": "look.rx",
          "to": {
            "get": "MouseLook.right[0]"
          }
        },
        {
          "res_set": "look.rz",
          "to": {
            "get": "MouseLook.right[2]"
          }
        }
      ],
      "enabled": true
    },
    {
      "name": "fp_walk",
      "doc": "Walk, sprint (stamina), creep, jump; F is the flashlight.",
      "each": [
        "Player",
        "CharacterBody",
        "Transform"
      ],
      "order": 10,
      "do": [
        {
          "res_set": "player.x",
          "to": {
            "get": "Transform.pos[0]"
          }
        },
        {
          "res_set": "player.y",
          "to": {
            "get": "Transform.pos[1]"
          }
        },
        {
          "res_set": "player.z",
          "to": {
            "get": "Transform.pos[2]"
          }
        },
        {
          "let": "want",
          "be": {
            "and": [
              {
                "gt": [
                  {
                    "res": "action.sprint"
                  },
                  0.5
                ]
              },
              {
                "lt": [
                  {
                    "get": "Player.tired"
                  },
                  0.5
                ]
              },
              {
                "gt": [
                  {
                    "add": [
                      {
                        "abs": {
                          "res": "action.move_x"
                        }
                      },
                      {
                        "abs": {
                          "res": "action.move_y"
                        }
                      }
                    ]
                  },
                  0.1
                ]
              }
            ]
          }
        },
        {
          "let": "speed",
          "be": {
            "select": [
              {
                "var": "want"
              },
              6.4,
              {
                "select": [
                  {
                    "gt": [
                      {
                        "res": "action.sneak"
                      },
                      0.5
                    ]
                  },
                  1.8,
                  3.4
                ]
              }
            ]
          }
        },
        {
          "set": "CharacterBody.walk[0]",
          "to": {
            "mul": [
              {
                "add": [
                  {
                    "mul": [
                      {
                        "res": "look.rx"
                      },
                      {
                        "res": "action.move_x"
                      }
                    ]
                  },
                  {
                    "mul": [
                      {
                        "res": "look.fx"
                      },
                      {
                        "res": "action.move_y"
                      }
                    ]
                  }
                ]
              },
              {
                "var": "speed"
              }
            ]
          }
        },
        {
          "set": "CharacterBody.walk[1]",
          "to": {
            "mul": [
              {
                "add": [
                  {
                    "mul": [
                      {
                        "res": "look.rz"
                      },
                      {
                        "res": "action.move_x"
                      }
                    ]
                  },
                  {
                    "mul": [
                      {
                        "res": "look.fz"
                      },
                      {
                        "res": "action.move_y"
                      }
                    ]
                  }
                ]
              },
              {
                "var": "speed"
              }
            ]
          }
        },
        {
          "if": {
            "var": "want"
          },
          "then": [
            {
              "set": "Player.stamina",
              "to": {
                "max": [
                  {
                    "sub": [
                      {
                        "get": "Player.stamina"
                      },
                      {
                        "mul": [
                          14,
                          {
                            "dt": true
                          }
                        ]
                      }
                    ]
                  },
                  0
                ]
              }
            }
          ],
          "else": [
            {
              "set": "Player.stamina",
              "to": {
                "min": [
                  {
                    "add": [
                      {
                        "get": "Player.stamina"
                      },
                      {
