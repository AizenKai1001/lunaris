 "systems": [
  {
   "name": "p1_walk",
   "doc": "The first player's keys (input.<key>) move the orange hero.",
   "each": [
    "P1",
    "CharacterBody"
   ],
   "do": [
    {
     "set": "CharacterBody.walk[0]",
     "to": {
      "mul": [
       {
        "sub": [
         {
          "res": "input.d"
         },
         {
          "res": "input.a"
         }
        ]
       },
       6
      ]
     }
    },
    {
     "set": "CharacterBody.walk[1]",
     "to": {
      "mul": [
       {
        "sub": [
         {
          "res": "input.s"
         },
         {
          "res": "input.w"
         }
        ]
       },
       6
      ]
     }
    },
    {
     "if": {
      "gt": [
       {
        "res": "input.space"
       },
       0.5
      ]
     },
     "then": [
      {
       "set": "CharacterBody.jump",
       "to": 7
      }
     ]
    }
   ]
  },
  {
   "name": "p2_walk",
   "doc": "The second player's keys (input.p2.<key>) move the blue hero.",
   "each": [
    "P2",
    "CharacterBody"
   ],
   "do": [
    {
     "set": "CharacterBody.walk[0]",
     "to": {
      "mul": [
       {
        "sub": [
         {
          "res": "input.p2.d"
         },
         {
          "res": "input.p2.a"
         }
        ]
       },
       6
      ]
     }
    },
    {
     "set": "CharacterBody.walk[1]",
     "to": {
      "mul": [
       {
        "sub": [
         {
          "res": "input.p2.s"
         },
         {
          "res": "input.p2.w"
         }
        ]
       },
       6
      ]
     }
    },
    {
     "if": {
      "gt": [
       {
        "res": "input.p2.space"
       },
       0.5
      ]
     },
     "then": [
      {
       "set": "CharacterBody.jump",
       "to": 7
      }
     ]
    }
   ]
  },
  {
   "name": "p1_pick",
   "doc": "Touching an orb scores for orange and removes it.",
   "on_contact": {
    "a": [
     "P1"
    ],
    "b": [
     "Orb"
    ]
   },
   "do": [
    {
     "res_add": "score1",
     "by": 1
    },
    {
     "emit": "coin"
    },
    {
     "despawn": "b"
    }
   ]
  },
  {
   "name": "p2_pick",
   "doc": "Touching an orb scores for blue and removes it.",
   "on_contact": {
    "a": [
