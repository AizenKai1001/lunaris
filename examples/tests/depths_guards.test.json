{
  "name": "Depths guards: guards that see the hero hunt it down and kill it (game over), Retry starts the level again with full health",
  "scene": "examples/depths/level1.lunaris.json",
  "seed": 1,
  "replay_check": true,
  "steps": [
    {
      "step": 3
    },
    {
      "call": {
        "tool": "set",
        "args": {
          "uid": 300,
          "component": "Transform",
          "value": {
            "pos": [
              -19.5,
              13.5,
              0
            ]
          }
        }
      }
    },
    {
      "call": {
        "tool": "set",
        "args": {
          "uid": 301,
          "component": "Transform",
          "value": {
            "pos": [
              -18.5,
              13.5,
              0
            ]
          }
        }
      }
    },
    {
      "call": {
        "tool": "set",
        "args": {
          "uid": 302,
          "component": "Transform",
          "value": {
            "pos": [
              -21.5,
              13.5,
              0
            ]
          }
        }
      }
    },
    {
      "step": 12
    },
    {
      "expect": {
        "entity": 300,
        "field": "Enemy.alert",
        "gt": 0,
        "message": "a guard that sees the hero is alerted (Sensor with line of sight)"
      }
    },
    {
      "until": {
        "name": "Hero",
        "field": "HitPoints.dead",
        "eq": true,
        "max_ticks": 1800
      }
    },
    {
      "expect": {
        "events": "hurt",
        "ge": 3,
        "message": "the guards bit the hero again and again"
      }
    },
    {
      "until": {
        "exists": "Game over title",
        "eq": true,
        "max_ticks": 240
      }
    },
    {
      "step": 40
    },
    {
      "expect": {
        "resource": "level",
        "eq": 1,
        "message": "the game over screen knows the level"
      }
    },
    {
      "expect": {
        "exists": "Hero",
        "eq": false
      }
    },
    {
      "input": {
        "enter": true
      }
    },
    {
      "step": 2
    },
    {
      "input": {
        "enter": false
      }
    },
    {
      "step": 2
    },
    {
      "until": {
        "exists": "Level 1",
        "eq": true,
        "max_ticks": 240
      }
    },
    {
      "step": 5
    },
    {
      "expect": {
        "name": "Hero",
        "field": "HitPoints.value",
        "eq": 100,
        "message": "Retry starts the level again with the health it began with"
      }
    },
    {
      "expect": {
        "resource": "hp",
        "eq": 100
      }
    }
  ]
}
