{
  "name": "First person: look with the mouse, walk the way you face, look up and down to the limit, jump (MouseLook on a camera child of a CharacterBody, a graph system walking forward and right)",
  "scene": "examples/first_person.lunaris.json",
  "seed": 1,
  "replay_check": true,
  "steps": [
    { "expect": { "check": "errors", "eq": 0 } },
    { "step": 10 },
    { "expect": { "entity": 40, "field": "Transform.pos[2]", "approx": [9, 0.05], "message": "the player stands where it was put" } },
    { "expect": { "entity": 41, "field": "MouseLook.yaw", "eq": 0, "message": "and has not turned" } },
    { "input": { "w": true } },
    { "step": 30 },
    { "input": { "w": false } },
    { "step": 5 },
    { "expect": { "entity": 40, "field": "Transform.pos[2]", "between": [5.5, 7.8], "message": "facing -z, W walks away from the start wall (a metre every fifth of a second)" } },
    { "expect": { "entity": 40, "field": "Transform.pos[0]", "approx": [0, 0.1], "message": "straight ahead" } },
    { "input": { "mouse_dx": 714 } },
    { "step": 1 },
    { "input": { "mouse_dx": 0 } },
    { "step": 2 },
    { "expect": { "entity": 41, "field": "MouseLook.yaw", "approx": [-1.5708, 0.01], "message": "714 pixels to the right at 0.0022 radians a pixel is a quarter turn to the right" } },
    { "expect": { "entity": 40, "field": "Transform.rot[1]", "approx": [-0.7071, 0.01], "message": "the body took the yaw" } },
    { "expect": { "entity": 41, "field": "LocalTransform.rot[1]", "approx": [0, 0.001], "message": "and the camera kept only the pitch" } },
    { "input": { "w": true } },
    { "step": 30 },
    { "input": { "w": false } },
    { "step": 5 },
    { "expect": { "entity": 40, "field": "Transform.pos[0]", "between": [2.0, 4.0], "message": "W now walks to the right of the old way (+x)" } },
    { "input": { "mouse_dy": -300 } },
    { "step": 1 },
    { "input": { "mouse_dy": 0 } },
    { "step": 1 },
    { "expect": { "entity": 41, "field": "MouseLook.pitch", "approx": [0.66, 0.01], "message": "300 pixels up is 0.66 radians of looking up" } },
    { "input": { "mouse_dy": -100000 } },
    { "step": 1 },
    { "input": { "mouse_dy": 0 } },
    { "step": 1 },
    { "expect": { "entity": 41, "field": "MouseLook.pitch", "approx": [1.5, 0.001], "message": "the neck stops at straight up" } },
    { "input": { "space": true } },
    { "step": 4 },
    { "input": { "space": false } },
    { "expect": { "entity": 40, "field": "Transform.pos[1]", "gt": 0.05, "message": "Space jumps" } },
    { "step": 90 },
    { "expect": { "entity": 40, "field": "Transform.pos[1]", "lt": 0.05, "message": "and the player comes down again" } }
  ]
}
