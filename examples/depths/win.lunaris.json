  "systems": [
    {
      "name": "scene_init",
      "doc": "The first tick of a scene: what the last scene left behind (a pause, a switch on its way) is cleared.",
      "each": [
        "Fader"
      ],
      "order": 0,
      "do": [
        {
          "if": {
            "eq": [
              {
                "get": "Fader.t"
              },
              0
            ]
          },
          "then": [
            {
              "set": "Fader.t",
              "to": 0.0001
            },
            {
              "res_set": "paused",
              "to": 0
            },
            {
              "res_set": "leave",
              "to": 0
            },
            {
              "res_set": "fire",
              "to": 0
            },
            {
              "res_set": "atk",
              "to": 0
            },
            {
              "res_set": "time.scale",
              "to": 1
            },
            {
              "emit": "win"
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "fader",
      "doc": "Anything that wants to leave sets `$leave` to the number of a switch; the picture fades to black, then the switch is thrown.",
      "each": [
        "Fader",
        "ColorGrade"
      ],
      "order": 60,
      "do": [
        {
