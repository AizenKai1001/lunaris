 ],
 "systems": [
  {
   "name": "walk_input",
   "doc": "Keys into the character controller: A/D and W/S set the walking speed (5 m/s), Space asks for a jump (6.5 m/s up) when on the ground.",
   "each": [
    "CharacterBody"
   ],
   "do": [
    {
     "set": "CharacterBody.walk[0]",
     "to": {
      "mul": [
       {
        "sub": [
         {
          "res": "input.d"
         },
         {
          "res": "input.a"
         }
        ]
       },
       5
      ]
     }
    },
    {
     "set": "CharacterBody.walk[1]",
     "to": {
      "mul": [
       {
        "sub": [
         {
          "res": "input.s"
         },
         {
          "res": "input.w"
         }
        ]
       },
       5
      ]
     }
    },
    {
     "if": {
      "gt": [
       {
        "res": "input.space"
       },
       0.5
      ]
     },
     "then": [
      {
       "set": "CharacterBody.jump",
       "to": 6.5
      }
     ]
    }
   ]
  }
 ]
}
