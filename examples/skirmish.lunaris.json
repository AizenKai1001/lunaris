  "resources": {
    "aim.x": 0,
    "aim.z": -1,
    "hero.hp": 100,
    "score": 0
  },
  "systems": [
    {
      "name": "hero_walk",
      "doc": "The keys become the hero's walk, and the last way it walked is the way it aims.",
      "each": [
        "Hero",
        "CharacterBody"
      ],
      "order": 10,
      "do": [
        {
          "set": "CharacterBody.walk[0]",
          "to": {
            "mul": [
              {
                "res": "action.move_x"
              },
              6
            ]
          }
        },
        {
          "set": "CharacterBody.walk[1]",
          "to": {
            "mul": [
              {
                "res": "action.move_y"
              },
              6
            ]
          }
        },
        {
          "if": {
            "or": [
              {
                "ne": [
                  {
                    "res": "action.move_x"
                  },
                  0
                ]
              },
              {
                "ne": [
                  {
                    "res": "action.move_y"
                  },
                  0
                ]
              }
            ]
          },
          "then": [
            {
              "res_set": "aim.x",
              "to": {
                "res": "action.move_x"
              }
            },
            {
              "res_set": "aim.z",
              "to": {
                "res": "action.move_y"
              }
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "hero_status",
      "doc": "What the grunts need to know about the hero, and the hero's health bar.",
      "each": [
        "Hero",
        "Transform",
        "HitPoints"
      ],
      "order": 11,
      "do": [
        {
          "res_set": "hero.x",
          "to": {
            "get": "Transform.pos[0]"
          }
        },
        {
          "res_set": "hero.z",
          "to": {
            "get": "Transform.pos[2]"
          }
        },
        {
          "res_set": "hero.hp",
          "to": {
            "floor": {
              "get": "HitPoints.value"
            }
          }
        },
        {
          "if": {
            "get": "HitPoints.dead"
          },
          "then": [
            {
              "res_set": "time.scale",
              "to": 0.25
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "muzzle",
      "doc": "The muzzle turns the way the hero aims and fires while the key is held.",
      "each": [
        "Muzzle",
        "LocalTransform",
        "PrefabSpawner"
      ],
      "order": 12,
      "do": [
        {
          "let": "yaw",
          "be": {
            "atan2": [
              {
                "neg": {
                  "res": "aim.x"
                }
              },
              {
                "neg": {
                  "res": "aim.z"
                }
              }
            ]
          }
        },
        {
          "set": "LocalTransform.rot[1]",
          "to": {
            "sin": {
              "mul": [
                {
                  "var": "yaw"
                },
                0.5
              ]
            }
          }
        },
        {
          "set": "LocalTransform.rot[3]",
          "to": {
            "cos": {
              "mul": [
                {
                  "var": "yaw"
                },
                0.5
              ]
            }
          }
        },
        {
          "set": "PrefabSpawner.active",
          "to": {
            "and": [
              {
                "gt": [
                  {
                    "res": "action.fire"
                  },
                  0.5
                ]
              },
              {
                "gt": [
                  {
                    "res": "hero.hp"
                  },
                  0
                ]
              }
            ]
          }
        }
      ],
      "enabled": true
    },
    {
      "name": "hunt",
      "doc": "Grunts head for the hero: every 20 ticks each asks for a new path (staggered by uid so they do not all plan at once).",
      "each": [
        "Enemy",
        "NavAgent"
      ],
      "order": 20,
      "do": [
        {
          "if": {
            "eq": [
              {
                "mod": [
                  {
                    "tick": true
                  },
                  20
                ]
              },
              {
                "mod": [
                  {
                    "uid": true
                  },
                  20
                ]
              }
            ]
          },
          "then": [
            {
              "set": "NavAgent.target[0]",
              "to": {
                "res": "hero.x"
              }
            },
            {
              "set": "NavAgent.target[1]",
              "to": 0
            },
            {
              "set": "NavAgent.target[2]",
              "to": {
                "res": "hero.z"
              }
            },
            {
              "set": "NavAgent.active",
              "to": true
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "grunt_bites",
      "doc": "A grunt that touches the hero bites, once in a while (the hero has a moment of grace after each bite).",
      "on_contact": {
        "a": [
          "Hero",
          "HitPoints"
        ],
        "b": [
          "Enemy"
        ]
      },
      "order": 30,
      "do": [
        {
          "if": {
            "and": [
              {
                "le": [
                  {
                    "get": "a.HitPoints.invulnerable"
                  },
                  0
                ]
              },
              {
                "not": {
                  "get": "a.HitPoints.dead"
                }
              }
            ]
          },
          "then": [
            {
              "set": "a.HitPoints.value",
              "to": {
                "sub": [
                  {
                    "get": "a.HitPoints.value"
                  },
                  12
                ]
              }
            },
            {
              "set": "a.HitPoints.invulnerable",
              "to": 0.7
            },
            {
              "emit": "hurt"
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "bolt_hits",
      "doc": "A bolt that reaches a grunt hurts it and is used up.",
      "on_contact": {
        "a": [
          "Bolt"
        ],
        "b": [
          "Enemy",
          "HitPoints"
        ]
      },
      "order": 31,
      "do": [
        {
          "set": "b.HitPoints.value",
          "to": {
            "sub": [
              {
                "get": "b.HitPoints.value"
              },
              15
            ]
          }
        },
        {
          "emit": "hit"
        },
        {
          "despawn": "a"
        }
      ],
      "enabled": true
    },
    {
      "name": "grunt_dies",
      "doc": "A dead grunt scores and goes.",
      "each": [
        "Enemy",
        "HitPoints"
      ],
      "order": 40,
      "do": [
        {
          "if": {
            "get": "HitPoints.dead"
          },
          "then": [
            {
              "res_add": "score",
              "by": 1
            },
            {
              "emit": "pop"
            },
            {
              "despawn": true
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "hud_bar",
      "each": [
        "HeroBar",
        "Ui"
      ],
      "order": 50,
      "do": [
        {
          "set": "Ui.fill",
          "to": {
            "div": [
              {
                "res": "hero.hp"
              },
              100
            ]
          }
        }
      ],
      "enabled": true
    },
    {
      "name": "hud_game_over",
      "each": [
        "GameOver",
        "Ui"
      ],
      "order": 50,
      "do": [
        {
          "set": "Ui.visible",
          "to": {
            "le": [
              {
                "res": "hero.hp"
              },
              0
            ]
          }
        }
      ],
      "enabled": true
    }
  ],
