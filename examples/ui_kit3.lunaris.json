  "resources": {
    "list.picked": 0,
    "ui.quality": 1,
    "ui.tab": 0,
    "inv.last_item": 0,
    "inv.moves": 0,
    "cooldown": 0
  },
  "systems": [
    {
      "name": "pick_item",
      "doc": "A click on a row of the list says which one in the resource list.picked.",
      "each": [
        "ListItem",
        "Ui"
      ],
      "do": [
        {
          "if": {
            "get": "Ui.clicked"
          },
          "then": [
            {
              "res_set": "list.picked",
              "to": {
                "get": "ListItem.n"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "remember_drop",
      "doc": "A drop on a slot is remembered in resources: which item, and how many drops there have been.",
      "each": [
        "UiDrop"
      ],
      "do": [
        {
          "if": {
            "get": "UiDrop.dropped"
          },
          "then": [
            {
              "res_set": "inv.last_item",
              "to": {
                "get": "UiDrop.item"
              }
            },
            {
              "res_add": "inv.moves",
              "by": 1
            }
          ]
        }
      ]
    },
    {
      "name": "use_ability",
      "order": 90,
      "doc": "A click on the Use button starts the cooldown (1 = just used) when it is not running.",
      "each": [
        "UseButton",
        "Ui"
      ],
      "do": [
        {
          "if": {
            "and": [
              {
                "get": "Ui.clicked"
              },
              {
                "le": [
                  {
                    "res": "cooldown"
                  },
                  0
                ]
              }
            ]
          },
          "then": [
            {
              "res_set": "cooldown",
              "to": 1
            }
          ]
        }
      ]
    },
    {
      "name": "run_cooldown",
      "order": 100,
      "doc": "The remaining share of the cooldown is what the dials show; it runs down in four seconds.",
      "each": [
        "UiRadial"
      ],
      "do": [
        {
          "set": "UiRadial.value",
          "to": {
            "res": "cooldown"
          }
        },
        {
          "res_set": "cooldown",
          "to": {
            "max": [
              0,
              {
                "sub": [
                  {
                    "res": "cooldown"
                  },
                  {
                    "mul": [
                      {
                        "dt": true
                      },
                      0.25
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
