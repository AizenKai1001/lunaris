 "resources": {
  "hp": 50
 },
 "systems": [
  {
   "name": "healbutton",
   "doc": "A click on the HealButton changes the health.",
   "each": [
    "HealButton",
    "Ui"
   ],
   "do": [
    {
     "if": {
      "get": "Ui.clicked"
     },
     "then": [
      {
       "res_set": "hp",
       "to": {
        "min": [
         100,
         {
          "add": [
           {
            "res": "hp"
           },
           10
          ]
         }
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "hurtbutton",
   "doc": "A click on the HurtButton changes the health.",
   "each": [
    "HurtButton",
    "Ui"
   ],
   "do": [
    {
     "if": {
      "get": "Ui.clicked"
     },
     "then": [
      {
       "res_set": "hp",
       "to": {
        "max": [
         0,
         {
          "sub": [
           {
            "res": "hp"
           },
           15
          ]
         }
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "resetbutton",
   "doc": "A click on the ResetButton changes the health.",
   "each": [
    "ResetButton",
    "Ui"
   ],
   "do": [
    {
     "if": {
      "get": "Ui.clicked"
     },
     "then": [
      {
       "res_set": "hp",
       "to": 100
      }
     ]
    }
   ]
  },
  {
   "name": "bar",
   "doc": "The bar shows the health: its fill, and a colour from red (empty) through yellow to green (full).",
   "each": [
    "HpBar",
    "Ui"
   ],
   "do": [
    {
     "set": "Ui.fill",
     "to": {
      "div": [
       {
        "res": "hp"
       },
       100
      ]
     }
    },
    {
     "set": "Ui.color[0]",
     "to": {
      "min": [
       1,
       {
        "mul": [
         2,
         {
          "sub": [
           1,
           {
            "div": [
             {
              "res": "hp"
             },
             100
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    {
     "set": "Ui.color[1]",
     "to": {
      "mul": [
       0.85,
       {
        "min": [
         1,
         {
          "mul": [
           2,
           {
            "div": [
             {
              "res": "hp"
             },
             100
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    },
    {
     "set": "Ui.color[2]",
     "to": 0.15
    }
   ]
  }
 ]
