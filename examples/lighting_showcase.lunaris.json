 "systems": [
  {
   "name": "walk",
   "doc": "W and S walk the camera along z, A and D along x (6 m/s): nothing stops it, it is a camera.",
   "each": [
    "Camera",
    "Transform"
   ],
   "do": [
    {
     "set": "Transform.pos[2]",
     "to": {
      "add": [
       {
        "get": "Transform.pos[2]"
       },
       {
        "mul": [
         {
          "sub": [
           {
            "res": "input.s"
           },
           {
            "res": "input.w"
           }
          ]
         },
         6,
         {
          "dt": true
         }
        ]
       }
      ]
     }
    },
    {
     "set": "Transform.pos[0]",
     "to": {
      "add": [
       {
        "get": "Transform.pos[0]"
       },
       {
        "mul": [
         {
          "sub": [
           {
            "res": "input.d"
           },
           {
            "res": "input.a"
           }
          ]
         },
         6,
         {
          "dt": true
         }
        ]
       }
      ]
     }
    }
   ]
  },
  {
   "name": "indoors",
   "doc": "The resource scene.indoors is 1 while the camera is inside the cellar (past the door at z = -20) and 0 outside: where the renderer's eye adaptation has something to do.",
   "each": [
    "Camera",
    "Transform"
   ],
   "order": 150,
   "do": [
    {
     "if": {
      "lt": [
       {
        "get": "Transform.pos[2]"
       },
       -20.5
      ]
     },
     "then": [
      {
       "res_set": "scene.indoors",
       "to": 1
      }
     ],
     "else": [
      {
       "res_set": "scene.indoors",
       "to": 0
      }
     ]
    }
   ]
  }
 ]
