  "systems": [
    {
      "name": "hero_move",
      "each": [
        "Hero",
        "Velocity"
      ],
      "doc": "Keys become velocity.",
      "do": [
        {
          "set": "Velocity.lin[0]",
          "to": {
            "mul": [
              {
                "get": "Hero.speed"
              },
              {
                "sub": [
                  {
                    "max": [
                      {
                        "res": "input.d"
                      },
                      {
                        "res": "input.arrowright"
                      }
                    ]
                  },
                  {
                    "max": [
                      {
                        "res": "input.a"
                      },
                      {
                        "res": "input.arrowleft"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "set": "Velocity.lin[2]",
          "to": {
            "mul": [
              {
                "get": "Hero.speed"
              },
              {
                "sub": [
                  {
                    "max": [
                      {
                        "res": "input.s"
                      },
                      {
                        "res": "input.arrowdown"
                      }
                    ]
                  },
                  {
                    "max": [
                      {
                        "res": "input.w"
                      },
                      {
                        "res": "input.arrowup"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "enabled": true
    },
    {
      "name": "coin_pickup",
      "on_contact": {
        "a": [
          "Hero"
        ],
        "b": [
          "Coin"
        ]
      },
      "doc": "Touching a coin scores and removes it.",
      "do": [
        {
          "res_add": "score",
          "by": 1
        },
        {
          "emit": "coin"
        },
        {
          "despawn": "b"
        }
      ],
      "enabled": true
    }
  ]
}
