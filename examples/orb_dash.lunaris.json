  "systems": [
    {
      "name": "timer",
      "order": 90,
      "doc": "Count the clock down until every orb is collected; publish it as `time_left`.",
      "each": [
        "Timer"
      ],
      "do": [
        {
          "if": {
            "lt": [
              {
                "res": "score"
              },
              12
            ]
          },
          "then": [
            {
              "set": "Timer.left",
              "to": {
                "max": [
                  0,
                  {
                    "sub": [
                      {
                        "get": "Timer.left"
                      },
                      {
                        "dt": true
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "res_set": "time_left",
          "to": {
            "get": "Timer.left"
          }
        },
        {
          "if": {
            "and": [
              {
                "ge": [
                  {
                    "res": "score"
                  },
                  12
                ]
              },
              {
                "eq": [
                  {
                    "res": "won_flag"
                  },
                  0
                ]
              }
            ]
          },
          "then": [
            {
              "res_set": "won_flag",
              "to": 1
            },
            {
              "emit": "win"
            }
          ]
        },
        {
          "if": {
            "and": [
              {
                "le": [
                  {
                    "get": "Timer.left"
                  },
                  0
                ]
              },
              {
                "not": {
                  "ge": [
                    {
                      "res": "score"
                    },
                    12
                  ]
                }
              },
              {
                "eq": [
                  {
                    "res": "lost_flag"
                  },
                  0
                ]
              }
            ]
          },
          "then": [
            {
              "res_set": "lost_flag",
              "to": 1
            },
            {
              "emit": "lose"
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "player_move",
      "order": 100,
      "doc": "Keys to velocity; publish the position for the other systems.",
      "each": [
        "Player",
        "Transform",
        "Velocity"
      ],
      "do": [
        {
          "let": "live",
          "be": {
            "select": [
              {
                "and": [
                  {
                    "gt": [
                      {
                        "res": "time_left"
                      },
                      0
                    ]
                  },
                  {
                    "not": {
                      "ge": [
                        {
                          "res": "score"
                        },
                        12
                      ]
                    }
                  }
                ]
              },
              1,
              0
            ]
          }
        },
        {
          "set": "Velocity.lin[0]",
          "to": {
            "mul": [
              {
                "get": "Player.speed"
              },
              {
                "var": "live"
              },
              {
                "sub": [
                  {
                    "max": [
                      {
                        "res": "input.d"
                      },
                      {
                        "res": "input.arrowright"
                      }
                    ]
                  },
                  {
                    "max": [
                      {
                        "res": "input.a"
                      },
                      {
