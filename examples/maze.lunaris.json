 "resources": {
  "legs": 0
 },
 "systems": [
  {
   "name": "patrol",
   "doc": "When the Seeker has arrived (NavAgent.status = 2), count the flag, choose the next one of the four and set off.",
   "each": [
    "NavAgent",
    "Patrol"
   ],
   "do": [
    {
     "if": {
      "eq": [
       {
        "get": "NavAgent.status"
       },
       2
      ]
     },
     "then": [
      {
       "res_add": "legs",
       "by": 1
      },
      {
       "let": "n",
       "be": {
        "mod": [
         {
          "add": [
           {
            "get": "Patrol.leg"
           },
           1
          ]
         },
         4
        ]
       }
      },
      {
       "set": "Patrol.leg",
       "to": {
        "var": "n"
       }
      },
      {
       "if": {
        "eq": [
         {
          "var": "n"
         },
         0
        ]
       },
       "then": [
        {
         "set": "NavAgent.target[0]",
         "to": -9
        },
        {
         "set": "NavAgent.target[1]",
         "to": 0
        },
        {
         "set": "NavAgent.target[2]",
         "to": -9
        }
       ]
      },
      {
       "if": {
        "eq": [
         {
          "var": "n"
         },
         1
        ]
       },
       "then": [
        {
         "set": "NavAgent.target[0]",
         "to": -3
        },
        {
         "set": "NavAgent.target[1]",
         "to": 0
        },
        {
         "set": "NavAgent.target[2]",
         "to": 9
        }
       ]
      },
      {
       "if": {
        "eq": [
         {
          "var": "n"
         },
         2
        ]
       },
       "then": [
        {
         "set": "NavAgent.target[0]",
         "to": 3
        },
        {
         "set": "NavAgent.target[1]",
         "to": 0
        },
        {
         "set": "NavAgent.target[2]",
         "to": -9
        }
       ]
      },
      {
       "if": {
        "eq": [
         {
          "var": "n"
         },
         3
        ]
       },
       "then": [
        {
         "set": "NavAgent.target[0]",
         "to": 9
        },
        {
         "set": "NavAgent.target[1]",
         "to": 0
        },
        {
         "set": "NavAgent.target[2]",
         "to": 9
        }
       ]
      },
      {
       "set": "NavAgent.active",
       "to": true
      }
     ]
    },
    {
     "if": {
      "eq": [
       {
        "get": "NavAgent.status"
       },
       0
      ]
     },
     "then": [
      {
       "set": "NavAgent.target[0]",
       "to": -3
      },
      {
       "set": "NavAgent.target[1]",
       "to": 0
      },
      {
       "set": "NavAgent.target[2]",
       "to": 9
      },
      {
       "set": "Patrol.leg",
       "to": 1
      },
      {
       "set": "NavAgent.active",
       "to": true
      }
     ]
    }
   ]
  }
 ]
