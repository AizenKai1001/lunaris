  "systems": [
    {
      "name": "scene_init",
      "doc": "The first tick of a scene.",
      "each": [
        "Fader"
      ],
      "order": 0,
      "do": [
        {
          "if": {
            "eq": [
              {
                "get": "Fader.t"
              },
              0
            ]
          },
          "then": [
            {
              "set": "Fader.t",
              "to": 0.0001
            },
            {
              "emit": "win"
            },
            {
              "res_set": "music",
              "to": 1
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "fader",
      "doc": "Anything that wants to leave sets `$leave` to the number of a switch; the picture fades to black, then the switch is thrown.",
      "each": [
        "Fader",
        "ColorGrade"
      ],
      "order": 60,
      "do": [
        {
          "set": "Fader.t",
          "to": {
            "add": [
              {
                "get": "Fader.t"
              },
              {
                "dt": true
              }
            ]
          }
        },
        {
          "if": {
            "and": [
              {
                "gt": [
                  {
                    "res": "leave"
                  },
                  0
                ]
              },
              {
                "eq": [
                  {
                    "get": "Fader.leaving"
                  },
                  0
                ]
              }
            ]
          },
          "then": [
            {
              "set": "Fader.leaving",
              "to": 1
            },
            {
              "set": "Fader.target",
              "to": {
                "res": "leave"
              }
            }
          ]
        },
        {
          "if": {
            "gt": [
              {
                "get": "Fader.leaving"
              },
              0
            ]
          },
          "then": [
            {
              "set": "Fader.out",
              "to": {
                "add": [
                  {
                    "get": "Fader.out"
                  },
                  {
                    "div": [
                      {
                        "dt": true
                      },
                      0.6
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "and": [
                  {
                    "ge": [
                      {
                        "get": "Fader.out"
                      },
                      1
                    ]
                  },
                  {
                    "eq": [
                      {
                        "get": "Fader.fired"
                      },
                      0
                    ]
                  }
                ]
              },
              "then": [
                {
                  "set": "Fader.fired",
                  "to": 1
                },
                {
                  "res_set": "fire",
                  "to": {
                    "get": "Fader.target"
                  }
                }
              ]
            }
          ]
        },
        {
          "set": "ColorGrade.fade[3]",
          "to": {
            "max": [
              {
                "clamp": [
                  {
                    "sub": [
                      1,
                      {
                        "div": [
                          {
                            "get": "Fader.t"
                          },
                          0.9
                        ]
                      }
                    ]
                  },
                  0,
                  1
                ]
              },
              {
                "clamp": [
                  {
                    "get": "Fader.out"
                  },
                  0,
                  1
                ]
              }
            ]
          }
        }
      ],
      "enabled": true
    },
    {
      "name": "fire_switch",
      "each": [
        "SwitchId",
        "SceneSwitch"
      ],
      "order": 70,
      "do": [
        {
          "if": {
            "and": [
              {
                "gt": [
                  {
                    "res": "fire"
                  },
                  0
                ]
              },
              {
                "eq": [
                  {
                    "res": "fire"
                  },
                  {
                    "get": "SwitchId.n"
                  }
                ]
              }
            ]
          },
          "then": [
            {
              "set": "SceneSwitch.go",
              "to": true
            },
            {
              "res_set": "fire",
              "to": 0
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "win_buttons",
      "each": [
        "WinBtn",
        "Ui"
      ],
      "order": 20,
      "do": [
        {
          "if": {
            "and": [
              {
                "get": "Ui.clicked"
              },
              {
                "eq": [
                  {
                    "res": "leave"
                  },
                  0
                ]
              }
            ]
          },
          "then": [
            {
              "emit": "select"
            },
            {
              "if": {
                "eq": [
                  {
                    "get": "WinBtn.kind"
                  },
                  1
                ]
              },
              "then": [
                {
                  "res_set": "leave",
                  "to": 11
                }
              ]
            },
            {
              "if": {
                "eq": [
                  {
                    "get": "WinBtn.kind"
                  },
                  2
                ]
              },
              "then": [
                {
                  "res_set": "leave",
                  "to": 3
                }
              ]
            }
          ]
        }
      ],
      "enabled": true
    },
    {
      "name": "music_select",
      "doc": "The tracks are one `MusicPlayer` each (in the boot scene, `Persist`); the scene says which should play with `$music`: 1 the title, 2 day, 3 night, 4 the boss.",
      "each": [
        "MusicTrack",
        "MusicPlayer"
      ],
      "order": 80,
      "do": [
        {
          "set": "MusicPlayer.playing",
          "to": {
            "eq": [
              {
                "res": "music"
              },
              {
                "get": "MusicTrack.id"
              }
            ]
          }
        }
      ],
      "enabled": true
    }
  ]
}
