 "systems": [
  {
   "name": "rain",
   "doc": "Every 15 ticks drop a Ball from [-10..10, 9, -10..10] with a little sideways speed.",
   "each": [
    "Spawner"
   ],
   "do": [
    {
     "if": {
      "eq": [
       {
        "mod": [
         {
          "tick": true
         },
         15
        ]
       },
       0
      ]
     },
     "then": [
      {
       "spawn_prefab": "Ball",
       "at": [
        {
         "sub": [
          {
           "mul": [
            {
             "rand": 1
            },
            20
           ]
          },
          10
         ]
        },
        9,
        {
         "sub": [
          {
           "mul": [
            {
             "rand": 2
            },
            20
           ]
          },
          10
         ]
        }
       ],
       "velocity": [
        {
         "sub": [
          {
           "mul": [
            {
             "rand": 3
            },
            2
           ]
          },
          1
         ]
        },
        0,
        {
         "sub": [
          {
           "mul": [
            {
             "rand": 4
            },
            2
           ]
          },
          1
         ]
        }
       ]
      },
      {
       "res_add": "dropped",
       "by": 1
      }
     ]
    }
   ]
  },
  {
   "name": "age",
   "doc": "Balls get old and disappear after seven seconds.",
   "each": [
    "Ball"
   ],
   "do": [
    {
     "set": "Ball.age",
     "to": {
      "add": [
       {
        "get": "Ball.age"
       },
       {
        "dt": true
       }
      ]
     }
    },
    {
     "if": {
      "gt": [
       {
        "get": "Ball.age"
       },
       7
      ]
     },
     "then": [
      {
       "despawn": true
      }
     ]
    }
   ]
  }
 ]
}
